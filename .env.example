# ============================================================
# NachoPps Restobar — Variables de Entorno (template)
# Copiar a .env y reemplazar placeholders con valores reales.
# Los nombres aquí coinciden EXACTAMENTE con los que lee
# infra/docker-compose.prod.yml (interpolación ${VAR}).
# ============================================================

# ── Registro de imágenes ───────────────────────────────
REGISTRY=ghcr.io/Maczz09/la-barra-del-ceviche

# ── Base de Datos (Postgres, una por servicio) ─────────
DB_USER=nachopps
DB_PASS=change_me_a_strong_password          # OBLIGATORIO en prod (fail-fast)

# ── RabbitMQ ───────────────────────────────────────────
RABBITMQ_USER=nachopps
RABBITMQ_PASS=change_me_a_strong_password    # OBLIGATORIO en prod (fail-fast)
# Backpressure: máximo de mensajes sin-ack en vuelo por consumidor (R-09).
# Sube el throughput con lotes pequeños; baja si un consumidor se satura.
RMQ_PREFETCH=20

# ── Resiliencia HTTP outbound (R-12/R-15) ──────────────
# Bulkhead: concurrencia + cola máx. por dependencia (pool aislado).
INVENTARIO_POOL_MAX=10
MESAS_POOL_MAX=10
CUENTAS_POOL_MAX=10
# Timeouts por operación (ms): lecturas cortas, dinero (cierre) más holgado.
# El timeout del breaker se fija a estos + 500 ms (breaker ≥ transporte).
INVENTARIO_TIMEOUT_MS=2000
MESAS_TIMEOUT_MS=2000
CUENTAS_TIMEOUT_MS=2000
CUENTAS_CIERRE_TIMEOUT_MS=4000

# ── JWT (firma de sesión) ──────────────────────────────
# Tokens de USUARIO en RS256 (asimétrico). Genera el par con:
#   node scripts/generate-jwt-keys.mjs
# Pega las PEM en una sola línea con "\n" escapados.
# La PRIVADA vive SOLO en servicio-identidad; la PÚBLICA va a todos + Kong.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----  # SOLO identidad, OBLIGATORIO en prod
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----      # todos los servicios, OBLIGATORIO en prod
# Access corto + refresh largo con rotación (plan 1.4).
JWT_EXPIRES_IN=15m                           # vida del access token
REFRESH_TOKEN_TTL_DAYS=7                      # vida del refresh token (cookie httpOnly)
# Tokens de SERVICIO (S2S interno, HS256). Secreto distinto al de usuario.
SERVICE_JWT_SECRET=change_me_a_long_random_secret  # OBLIGATORIO en prod
# T-17/T-37/T-56b: rechazo estricto de tokens S2S con audiencia incorrecta.
# La ausencia de esta variable ya no activa modo tolerante; se conserva explicita
# para que la configuracion sea legible en despliegues.
SERVICE_AUD_ENFORCE=true

# ── Kong (API Gateway) ─────────────────────────────────
KONG_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----  # == JWT_PUBLIC_KEY (RS256)
# CORS del gateway: secuencia YAML en línea con el/los dominio(s) https de la PWA.
KONG_CORS_ORIGINS=["https://app.tudominio.com"]    # OBLIGATORIO en prod
KONG_RATE_LIMIT_MINUTE=3000
KONG_RATE_LIMIT_HOUR=30000

# ── CORS a nivel de microservicio (defensa en profundidad) ──
# Coma-separado. Mismo dominio https de la PWA.
CORS_ORIGIN=https://app.tudominio.com        # OBLIGATORIO en prod (fail-fast)

# ── SUNAT (servicio-facturacion) ───────────────────────
# Clave AES-256-GCM (hex, 32 bytes = 64 caracteres) para cifrar en la BD las
# credenciales SUNAT que se configuran desde la UI (usuario SOL, contraseña,
# certificado .pfx) — módulo Facturación → "Configurar SUNAT". Sin esto, ese
# formulario no funciona (falla al guardar), pero el resto del deploy no se
# ve afectado. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACTURACION_CRED_ENCRYPTION_KEY=change_me_64_hex_chars

# Deliberadamente opcionales (no OBLIGATORIO): el deploy no debe fallar
# mientras no tengas certificado/SOL de una o ambas empresas tramitados.
# En prod, mejor usar infra/docker-compose.secrets.yml (ver infra/secrets/README.md)
# en vez de dejar el .pfx/contraseñas en este archivo en claro.
# Endpoint de PRODUCCIÓN (comprobantes reales, con efecto legal/tributario).
# El contrato SOAP es idéntico entre beta y producción — validado 2026-08-12
# contra beta real (SUNAT respondió "Factura aceptada", ver CONTEXTO.md de
# servicio-facturacion). Para volver a homologación/pruebas:
#   https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService?wsdl
SUNAT_WSDL_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService?wsdl
SUNAT_PFX_EMPRESA_1_FILE=
SUNAT_PFX_EMPRESA_1_PASS=
SUNAT_SOL_USER_EMPRESA_1=
SUNAT_SOL_PASS_EMPRESA_1=
SUNAT_PFX_EMPRESA_2_FILE=
SUNAT_PFX_EMPRESA_2_PASS=
SUNAT_SOL_USER_EMPRESA_2=
SUNAT_SOL_PASS_EMPRESA_2=

# ── Compras (servicio-compras: fotos de boleta/factura) ─
# Parámetros del pipeline de compresión de imagen (sharp → WebP). Los
# defaults ya balancean legibilidad de boleta vs tamaño; solo tocar si hace
# falta ajustar el ahorro de espacio para el volumen del negocio.
COMPROBANTE_MAX_BYTES=12582912                # 12 MB, límite de subida antes de comprimir
COMPROBANTE_MAX_LADO=1600                     # px, lado máximo tras el resize
COMPROBANTE_WEBP_QUALITY=72                   # calidad WebP (0-100)

# ── Observabilidad ─────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_PASS=change_me                       # OBLIGATORIO en prod (fail-fast)
# Webhook Slack para alertas de outbox FAILED (plan 3.3). Opcional; si se omite,
# la alerta solo se loguea. Las alertas de Prometheus van por Alertmanager.
SLACK_WEBHOOK_URL=
