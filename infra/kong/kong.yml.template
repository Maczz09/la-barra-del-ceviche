# Kong declarative config — NachoPps API Gateway
# Proxy: http://localhost:8000  |  Admin: http://localhost:8001
#
# ESTE ES UN TEMPLATE — se genera kong.yml en el entrypoint vía envsubst
# Variable inyectada: ${KONG_JWT_PUBLIC_KEY} (PEM RS256, \n literales)
#
# Rutas: http://localhost:8000/{servicio}/...  →  microservicio en host:PORT/api/...
# Ejemplo: POST http://localhost:8000/pedidos/pedidos  →  localhost:3004/api/pedidos
#
# ── JWT ──────────────────────────────────────────────────────────
# Login:  POST http://localhost:8000/identidad/auth/login  (público, sin JWT)
# Demás:  requieren header "Authorization: Bearer <token>"
# Token emitido por servicio-identidad con iss=nachopps-identidad
# ─────────────────────────────────────────────────────────────────

_format_version: "3.0"
_transform: true

# ── Plugins globales ─────────────────────────────────────────────

plugins:
  - name: cors
    config:
      # Orígenes permitidos inyectados por entorno (envsubst). En producción debe
      # contener el/los dominio(s) https reales de la PWA. Formato: secuencia YAML
      # en línea, p.ej.  KONG_CORS_ORIGINS='["https://app.tudominio.com"]'
      origins: ${KONG_CORS_ORIGINS}
      methods:
        - GET
        - POST
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      headers:
        - Accept
        - Authorization
        - Content-Type
        - Idempotency-Key
        - X-CSRF-Token
        - X-Requested-With
      exposed_headers:
        - X-Request-Id
      credentials: true
      max_age: 3600

  - name: rate-limiting
    config:
      minute: ${KONG_RATE_LIMIT_MINUTE}
      hour: ${KONG_RATE_LIMIT_HOUR}
      policy: local
      fault_tolerant: true
      hide_client_headers: false

  - name: jwt-cache
    config:
      cache_ttl: 60
      max_entries: 10000
      degraded_mode: true

  # A-3 (auditoría de carga): expone métricas del gateway en :8001/metrics —
  # única forma de ver los 429 del rate-limiting y la latencia añadida por Kong.
  - name: prometheus
    config:
      status_code_metrics: true
      latency_metrics: true
      bandwidth_metrics: false
      upstream_health_metrics: true

  # Correlación de reintentos del cliente (gap hallado en sesión de caos manual):
  # el access log nativo de Kong da un kong_request_id NUEVO por cada intento, así
  # que 3 reintentos de un mismo click en la PWA (misma Idempotency-Key) quedaban
  # como 3 líneas sin relación entre sí. JSON estructurado a stdout, mismo stream
  # que ya scrapea Promtail → queryable en Loki con `| json | idempotency_key="..."`.
  - name: file-log
    config:
      path: /dev/stdout
      custom_fields_by_lua:
        idempotency_key: "return kong.request.get_header('Idempotency-Key')"

# ── Consumers (JWT) ──────────────────────────────────────────────

consumers:
  - username: nachopps-app
    jwt_secrets:
      # RS256 (plan 2.1): Kong sólo verifica con la clave pública. El `\n` literal
      # de ${KONG_JWT_PUBLIC_KEY} se interpreta como salto de línea al estar en una
      # cadena YAML entre comillas dobles.
      - key: nachopps-identidad
        algorithm: RS256
        rsa_public_key: "${KONG_JWT_PUBLIC_KEY}"

# ── Servicios ────────────────────────────────────────────────────
# T-07: presupuestos de tiempo por servicio (connect 2s / read·write 10s,
# retries 1) para que Kong falle rápido ante un upstream muerto o una IP
# cacheada obsoleta, en vez de colgarse 60s conectando. Coherente con los
# timeouts de 2–4s por operación de los clientes HTTP internos.
# Ver docs/operacion/runbooks/kong-dns-upstream.md.

services:
  # ── T-16: bloquear /telemetry/metrics para todos los servicios ──
  - name: bloqueo-metrics
    url: http://localhost:1  # nunca alcanzado; request-termination responde antes
    routes:
      - name: block-telemetry-metrics
        paths:
          - ~/.*\/telemetry\/metrics$
        strip_path: false
        plugins:
          - name: request-termination
            config:
              status_code: 404
              message: "Not found"

  # ── Identidad (rutas separadas por función — T-01) ──
  - name: servicio-identidad-login
    url: http://servicio-identidad:3000/api/auth/login
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    routes:
      - name: identidad-login
        paths:
          - /identidad/auth/login
          - /v1/identidad/auth/login
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 5          # 5 intentos/min por IP
              policy: local
              limit_by: ip
              fault_tolerant: true
              hide_client_headers: false

  - name: servicio-identidad-refresh
    url: http://servicio-identidad:3000/api/auth/refresh
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    routes:
      - name: identidad-refresh
        paths:
          - /identidad/auth/refresh
          - /v1/identidad/auth/refresh
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 60         # 20 dispositivos × refresh cada 15min ≈ 2/min + margen
              policy: local
              limit_by: ip
              fault_tolerant: true
              hide_client_headers: false

  - name: servicio-identidad-logout
    url: http://servicio-identidad:3000/api/auth/logout
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: identidad-logout
        paths:
          - /identidad/auth/logout
          - /v1/identidad/auth/logout
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 30
              policy: local
              limit_by: ip
              fault_tolerant: true
              hide_client_headers: false

  # Carta pública/QR (T-XX): sin JWT — cualquiera con el link/QR la llama.
  # Sin plugin jwt a propósito, igual que login/refresh/logout arriba.
  - name: servicio-identidad-sede-publica
    url: http://servicio-identidad:3000/api/sedes/publica
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    routes:
      - name: identidad-sede-publica
        paths:
          - /identidad/sedes/publica
          - /v1/identidad/sedes/publica
        strip_path: true
        methods:
          - GET

  - name: servicio-identidad
    url: http://servicio-identidad:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: identidad
        paths: [/identidad, /v1/identidad]
        strip_path: true

  # ── Mesas ──
  - name: servicio-mesas
    url: http://servicio-mesas:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: mesas
        paths: [/mesas, /v1/mesas]
        strip_path: true

  # ── Pedidos ──
  - name: servicio-pedidos
    url: http://servicio-pedidos:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: pedidos
        paths: [/pedidos, /v1/pedidos]
        strip_path: true

  # ── Cuentas ──
  - name: servicio-cuentas
    url: http://servicio-cuentas:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: cuentas
        paths: [/cuentas, /v1/cuentas]
        strip_path: true

  # ── Reservas ──
  - name: servicio-reservas
    url: http://servicio-reservas:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: reservas
        paths: [/reservas, /v1/reservas]
        strip_path: true

  # ── Inventario ──
  # Carta pública/QR (T-XX): sin JWT — cualquiera con el link/QR la llama.
  - name: servicio-inventario-carta-publica
    url: http://servicio-inventario:3000/api/carta-publica
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    routes:
      - name: inventario-carta-publica
        paths:
          - /inventario/carta-publica
          - /v1/inventario/carta-publica
        strip_path: true
        methods:
          - GET

  - name: servicio-inventario
    url: http://servicio-inventario:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: inventario
        paths: [/inventario, /v1/inventario]
        strip_path: true

  # ── Notificaciones ──
  # WebSocket (socket.io) vive en esta misma ruta: read/write_timeout altos
  # a propósito, NO el default de 10s de los servicios REST. Un socket.io
  # inactivo entre pings (pingInterval 25s) no manda bytes por ese lapso —
  # con 10s Kong lo mataba por "read timeout" antes de que llegara el
  # siguiente ping, y el cliente se veía reconectando en loop cada ~10s
  # (handleConnection/handleDisconnect alternando sin parar en los logs).
  # El propio heartbeat de socket.io sigue detectando conexiones realmente
  # muertas; esto solo evita que Kong corte una conexión sana e inactiva.
  - name: servicio-notificaciones
    url: http://servicio-notificaciones:3000/api
    connect_timeout: 2000
    read_timeout: 3600000
    write_timeout: 3600000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: notificaciones
        paths: [/notificaciones, /v1/notificaciones]
        strip_path: true

  # Carta pública/QR (T-XX): WebSocket de disponibilidad sin JWT — path
  # propio (no un namespace del socket.io de arriba, que SÍ exige jwt a
  # nivel de todo el route) para que Kong pueda diferenciarlo por path
  # literal, igual que /sedes/publica y /carta-publica. read/write_timeout
  # altos por la misma razón que el socket.io del KDS (pings de socket.io).
  - name: servicio-notificaciones-carta-socket
    url: http://servicio-notificaciones:3000/api/carta-socket.io
    connect_timeout: 2000
    read_timeout: 3600000
    write_timeout: 3600000
    retries: 1
    routes:
      - name: notificaciones-carta-socket
        paths:
          - /notificaciones/carta-socket.io
          - /v1/notificaciones/carta-socket.io
        strip_path: true

  # ── Caja ──
  - name: servicio-caja
    url: http://servicio-caja:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: caja
        paths: [/caja, /v1/caja]
        strip_path: true

  # ── Reportes ──
  - name: servicio-reportes
    url: http://servicio-reportes:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: reportes
        paths: [/reportes, /v1/reportes]
        strip_path: true

  # ── Facturación electrónica ──
  - name: servicio-facturacion
    url: http://servicio-facturacion:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
    routes:
      - name: facturacion
        paths: [/facturacion, /v1/facturacion]
        strip_path: true

  # ── Compras / Proveedores ──
  - name: servicio-compras
    url: http://servicio-compras:3000/api
    connect_timeout: 2000
    read_timeout: 10000
    # 30000 (no 10000 como el resto): este servicio recibe subida de fotos de
    # comprobante. Con precompresión client-side el upload típico es ~200 KB,
    # pero un cliente que la salte puede mandar hasta 12 MB por 3G del local.
    write_timeout: 30000
    retries: 1
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify:
            - exp
          cookie_names:
            - access_token
      - name: request-size-limiting
        config:
          allowed_payload_size: 16
          size_unit: megabytes
    routes:
      - name: compras
        paths: [/compras, /v1/compras]
        strip_path: true

  # ── Frontend PWA ──
  - name: pwa-cliente
    url: http://pwa-cliente:8080
    connect_timeout: 2000
    read_timeout: 10000
    write_timeout: 10000
    retries: 1
    routes:
      - name: pwa
        paths: [/]
        strip_path: false
