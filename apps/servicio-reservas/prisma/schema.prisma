generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reserva {
  id              String   @id @default(uuid())
  sedeId          String
  clienteId       String?
  clienteNombre   String
  clienteTelefono String?
  fecha           DateTime @db.Date
  hora            String
  mesaPreferida   String
  numComensales   Int      @default(2)
  estado          String   @default("PENDIENTE")
  usuarioId       String?
  usuarioNombre   String?
  // Código legible ("R0000001"), asignado una sola vez al crear la reserva
  // — nullable porque las reservas creadas antes de este campo no tienen
  // uno retroactivo. Único por sede.
  correlativo     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fecha, hora])
  @@index([estado])
  @@index([usuarioId])
  @@index([sedeId, fecha])
  @@unique([sedeId, correlativo])
}

// Correlativo legible por sede ("R0000001"), mismo patrón que
// SecuenciaOrden en servicio-compras.
model SecuenciaReserva {
  sedeId String @id
  ultimo Int    @default(0)

  @@map("secuencias_reserva")
}

model OutboxEvent {
  id         String   @id @default(uuid())
  routingKey String
  payload    String
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}
