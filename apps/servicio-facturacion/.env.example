PORT=3011
DATABASE_URL="postgresql://user:password@localhost:5442/facturacion_db?schema=public"

# ── SUNAT: entorno del servicio web billService ────────────────────
# Producción. Usa credenciales y certificados vigentes de cada RUC; cualquier
# comprobante enviado a este endpoint tiene efectos tributarios reales.
SUNAT_WSDL_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService?wsdl

# Cifra las credenciales SUNAT cargadas por el formulario "Configurar SUNAT"
# de Facturación (ver CredencialesCryptoService) antes de guardarlas — 32
# bytes en hex (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta variable el formulario rechaza guardar credenciales, pero el
# servicio sigue funcionando con el mecanismo viejo (SUNAT_*_EMPRESA_<n>_*).
FACTURACION_CRED_ENCRYPTION_KEY=change_me

# ── Empresa 1 (La Barra del Ceviche 1) ─────────────────────────────
SUNAT_PFX_EMPRESA_1_FILE=/run/secrets/sunat_pfx_ruc1
SUNAT_PFX_EMPRESA_1_PASS=change_me
SUNAT_SOL_USER_EMPRESA_1=change_me
SUNAT_SOL_PASS_EMPRESA_1=change_me

# ── Empresa 2 (La Barra del Ceviche 2) ─────────────────────────────
SUNAT_PFX_EMPRESA_2_FILE=/run/secrets/sunat_pfx_ruc2
SUNAT_PFX_EMPRESA_2_PASS=change_me
SUNAT_SOL_USER_EMPRESA_2=change_me
SUNAT_SOL_PASS_EMPRESA_2=change_me
