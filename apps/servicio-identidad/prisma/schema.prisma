generator client {
  provider = "prisma-client-js"
  engineType = "library"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                  String    @id @default(uuid())
  nombre              String
  email               String    @unique
  password            String
  telefono            String?
  rol                 String    @default("MESERO")
  activo              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // T-23 (multi-sede): null = admin general, sin sede fija — opera cualquier
  // sede que elija en el navbar. No-null = usuario pineado a esa sede única.
  sedeId              String?
  sede                Sede?     @relation(fields: [sedeId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([sedeId])
}

// T-23: local/sucursal. El admin general las crea y elige en cuál operar;
// el resto del personal queda pineado a una sola vía Usuario.sedeId.
model Sede {
  id        String    @id @default(uuid())
  nombre    String    @unique
  direccion String?
  ruc       String?
  telefono  String?
  activa    Boolean   @default(true)
  usuarios  Usuario[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("sedes")
}

// Refresh tokens (plan 1.4): tokens opacos guardados HASHEADOS. Rotación con
// detección de reuso (un token revocado que reaparece revoca toda la cadena).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditoriaLog {
  id        String   @id @default(uuid())
  accion    String
  usuarioId String
  servicio  String
  ip        String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model OutboxEvent {
  id         String   @id @default(uuid())
  routingKey String
  payload    String
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}
